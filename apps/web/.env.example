# Backend FastAPI base URL. Override per-environment as needed.
VITE_API_BASE_URL=http://localhost:8000

# M1 demo: tenant used by the login form's X-Tenant-Id header.
# The backend scopes credential lookup by tenant; for the M1 single-tenant
# demo we hardcode one. Set this to your seeded tenant id for real use.
VITE_DEMO_TENANT_ID=demo