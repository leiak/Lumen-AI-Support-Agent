# Backend FastAPI base URL. Override per-environment as needed.
VITE_API_BASE_URL=http://localhost:8000

# Stage 9.3.x: the login form now resolves the tenant from the typed
# email via GET /api/v1/auth/lookup-tenant, so the previous
# VITE_DEMO_TENANT_ID placeholder is gone. Per-call the X-Tenant-Id
# header is attached on POST /api/v1/auth/login from the resolved
# tenant id; nothing global is required here.