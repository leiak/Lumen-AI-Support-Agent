# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SERVICE_NAME=ai-customer-api

# Database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/dbname
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
OLLAMA_BASE_URL=

# Auth
# Generate a real secret with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# The literal below is intentionally a placeholder and will be rejected
# by core.config._validate_jwt_secret in production environments.
JWT_SECRET=REPLACE_ME_GENERATE_VIA_python_secrets_token_urlsafe
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=60

# ─── M4.D — Per-tenant monthly token budget ─────────────────────────────
# Budget enforcement is opt-in per tenant (no `tenant_budgets` row = no
# enforcement). Defaults below match the production-tested Pack A/B
# configuration. Adjust per environment if a tenant explicitly needs
# different behavior.

# Snapshot cache (LRU + TTL). M4.D core — soft escape hatch only when
# TENANT_BUDGET_PRE_CHECK_USE_DB=false.
TENANT_BUDGET_CACHE_TTL_S=60
TENANT_BUDGET_CACHE_MAXSIZE=1024

# Pack A — DB-direct pre-check (default True, closes ≤60s overshoot window).
# Set False only as a soft escape hatch — reintroduces the TTL window.
TENANT_BUDGET_PRE_CHECK_USE_DB=true

# Pack A — Daily cleanup retention (arq cron at 02:00 UTC, LIMIT 10000).
# 13 = 12 audit retention + 1 buffer month.
TENANT_BUDGET_CLEANUP_RETENTION_MONTHS=13

# Pack B #8 — Post-mortem budget gate. After a 429 from the provider
# chain, if effective_cap - tokens_used < this threshold,
# BudgetResolver raises TenantBudgetRateLimited (HTTP 429) instead of
# letting the upstream 429 propagate. Set 0 to disable the gate.
TENANT_BUDGET_429_SKIP_THRESHOLD_TOKENS=1000

# Pack B #5 — In-process TTL for the per-model breakdown cache backing
# `?breakdown=true` snapshot queries. Short enough that admin dashboards
# refresh quickly, long enough to absorb burst traffic.
TENANT_BUDGET_PER_MODEL_CACHE_TTL_SECONDS=30

# Pack B follow-up — in-process TTL for the pre-check short-circuit cache.
# 5s amortizes the per-turn DB round-trip without risk of a stale
# "below cap" decision (post_record invalidates the entry on every write).
TENANT_BUDGET_PRECHECK_CACHE_TTL_S=5.0

# LLM
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_MODEL=claude-3-5-sonnet-20241022

# Embedding model for KB indexing + retrieval. The matching vector
# dimension is resolved from EMBEDDING_VECTOR_SIZES (knowledge/qdrant_client.py);
# unknown models will fail loudly at Qdrant collection create time
# instead of silently truncating vectors.
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# Doubao / Volcano Engine Ark (OpenAI-compatible embedding endpoint).
# Setting DOUBAO_API_KEY routes the embedding client to ``DOUBAO_BASE_URL``
# instead of OpenAI's default. Pair with one of:
#   DEFAULT_EMBEDDING_MODEL=doubao-embedding        # 1024 dim
#   DEFAULT_EMBEDDING_MODEL=doubao-embedding-large  # 2048 dim
# Leave DOUBAO_API_KEY blank to keep using OpenAI.
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# CORS / widget origin allowlist (comma-separated).
# Production must override with the customer's actual embedding host(s).
WIDGET_ALLOWED_ORIGINS_GLOBAL=http://localhost:5173,http://localhost:3000

# Number of trusted reverse proxies in front of the API. The X-Forwarded-For
# header is read only when this is > 0. Set 1 for a single edge proxy,
# 0 for direct-internet deployments. Default 0 (safe).
TRUSTED_PROXY_HOPS=0

# MiniMax (OpenAI-compatible); preferred provider when set
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
